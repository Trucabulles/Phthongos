# Translation resources are embedded, so a portable build does not depend on loose JSON files.
set(PHT_TRANSLATION_FR "${CMAKE_CURRENT_SOURCE_DIR}/translations/fr.json")
set(PHT_TRANSLATION_EN "${CMAKE_CURRENT_SOURCE_DIR}/translations/en.json")
set_property(DIRECTORY APPEND PROPERTY CMAKE_CONFIGURE_DEPENDS "${PHT_TRANSLATION_FR}" "${PHT_TRANSLATION_EN}")
file(READ "${PHT_TRANSLATION_FR}" PHT_FR)
file(READ "${PHT_TRANSLATION_EN}" PHT_EN)
string(JSON PHT_TRANSLATION_COUNT LENGTH "${PHT_FR}")
string(JSON PHT_EN_COUNT LENGTH "${PHT_EN}")
if(NOT PHT_TRANSLATION_COUNT EQUAL PHT_EN_COUNT)
  message(FATAL_ERROR "FR and EN catalogs must have the same keys")
endif()
math(EXPR PHT_TRANSLATION_LAST "${PHT_TRANSLATION_COUNT}-1")
set(PHT_TRANSLATION_ROWS "static constexpr Entry entries[] = {\n")
foreach(index RANGE 0 ${PHT_TRANSLATION_LAST})
  string(JSON key MEMBER "${PHT_FR}" ${index})
  string(JSON french GET "${PHT_FR}" "${key}")
  string(JSON english GET "${PHT_EN}" "${key}")
  string(APPEND PHT_TRANSLATION_ROWS "{R\"phtloc(${key})phtloc\",R\"phtloc(${french})phtloc\",R\"phtloc(${english})phtloc\"},\n")
endforeach()
string(APPEND PHT_TRANSLATION_ROWS "};\n")
file(CONFIGURE OUTPUT "${CMAKE_CURRENT_BINARY_DIR}/generated/Translations.inc" CONTENT "${PHT_TRANSLATION_ROWS}" @ONLY)
